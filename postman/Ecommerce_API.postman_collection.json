      "item": [
        {
          "name": "CREATE NEW PRODUCT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Visualization Script",
                  "// Visualization Script",
                  "const template = `",
                  "<div style=\"padding: 20px; font-family: Arial, sans-serif;\">",
                  "  <h2>Product Data Visualization</h2>",
                  "  <div style=\"display: flex; gap: 30px; margin-top: 20px;\">",
                  "    <div style=\"flex: 1;\">",
                  "      <h3>{{product.name}}</h3>",
                  "      <p><strong>Category:</strong> {{product.category}}</p>",
                  "      <p><strong>Description:</strong> {{product.description}}</p>",
                  "    </div>",
                  "    <div style=\"flex: 1;\">",
                  "      <table style=\"width: 100%; border-collapse: collapse;\">",
                  "        <tr style=\"background-color: #f0f0f0;\">",
                  "          <th style=\"border: 1px solid #ddd; padding: 8px; text-align: left;\">Metric</th>",
                  "          <th style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">Value</th>",
                  "        </tr>",
                  "        <tr>",
                  "          <td style=\"border: 1px solid #ddd; padding: 8px;\">Price</td>",
                  "          <td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">₹{{product.price}}</td>",
                  "        </tr>",
                  "        <tr style=\"background-color: #f9f9f9;\">",
                  "          <td style=\"border: 1px solid #ddd; padding: 8px;\">Rating</td>",
                  "          <td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">{{product.rating}}/5</td>",
                  "        </tr>",
                  "        <tr>",
                  "          <td style=\"border: 1px solid #ddd; padding: 8px;\">Stock</td>",
                  "          <td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">{{product.stock}} units</td>",
                  "        </tr>",
                  "      </table>",
                  "    </div>",
                  "  </div>",
                  "  <div style=\"margin-top: 30px;\">",
                  "    <h3>Bar Chart - Numeric Values</h3>",
                  "    <div style=\"display: flex; align-items: flex-end; gap: 20px; height: 250px; margin-top: 20px;\">",
                  "      <div style=\"flex: 1; display: flex; flex-direction: column; align-items: center;\">",
                  "        <div style=\"width: 60px; background-color: #3498db; height: {{priceHeight}}px; border-radius: 4px;\"></div>",
                  "        <p style=\"margin-top: 10px; font-weight: bold;\">Price</p>",
                  "        <p style=\"color: #666;\">₹{{product.price}}</p>",
                  "      </div>",
                  "      <div style=\"flex: 1; display: flex; flex-direction: column; align-items: center;\">",
                  "        <div style=\"width: 60px; background-color: #2ecc71; height: {{ratingHeight}}px; border-radius: 4px;\"></div>",
                  "        <p style=\"margin-top: 10px; font-weight: bold;\">Rating</p>",
                  "        <p style=\"color: #666;\">{{product.rating}}/5</p>",
                  "      </div>",
                  "      <div style=\"flex: 1; display: flex; flex-direction: column; align-items: center;\">",
                  "        <div style=\"width: 60px; background-color: #e74c3c; height: {{stockHeight}}px; border-radius: 4px;\"></div>",
                  "        <p style=\"margin-top: 10px; font-weight: bold;\">Stock</p>",
                  "        <p style=\"color: #666;\">{{product.stock}} units</p>",
                  "      </div>",
                  "    </div>",
                  "  </div>",
                  "</div>",
                  "`;",
                  "",
                  "function createPayload() {",
                  "  const response = pm.response.json();",
                  "  const product = response.product;",
                  "  ",
                  "  // Calculate bar heights (normalized to fit in 200px max height)",
                  "  const maxPrice = 1000;",
                  "  const maxRating = 5;",
                  "  const maxStock = 100;",
                  "  ",
                  "  const priceHeight = (product.price / maxPrice) * 200;",
                  "  const ratingHeight = (product.rating / maxRating) * 200;",
                  "  const stockHeight = (product.stock / maxStock) * 200;",
                  "  ",
                  "  return {",
                  "    product: product,",
                  "    priceHeight: priceHeight,",
                  "    ratingHeight: ratingHeight,",
                  "    stockHeight: stockHeight",
                  "  };",
                  "}",
                  "",
                  "pm.visualizer.set(template, createPayload());"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
